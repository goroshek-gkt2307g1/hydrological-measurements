<Window x:Class="Гидрологические_измерения.Views.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Гидрологические_измерения.Views"
        mc:Ignorable="d"
        Title="Оборудование" Height="720" Width="1080">

	<Window.Resources>
		<Style x:Key="ActiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#2C7DA0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>
		<Style x:Key="InactiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="Black"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFE5F3FF"/>
					<Setter Property="Foreground" Value="Black"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Foreground" Value="#4A7B9C"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="300"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
			<Button Content="Главная" Height="40" Margin="5,0,5,0" Width="160"
                    FontSize="22" Style="{StaticResource InactiveButtonStyle}"
                    Click="Button_Main_Click"/>
			<Button Content="Проекты" Height="40" Margin="5,0,5,0" Width="160"
                    FontSize="22" Style="{StaticResource InactiveButtonStyle}"
                    Click="Button_Projects_Click"/>
			<Button Content="Гидропосты" Height="40" Margin="5,0,5,0" Width="160"
                    FontSize="22" Style="{StaticResource InactiveButtonStyle}"
                    Click="Button_HydroPosts_Click"/>
			<Button Content="Оборудование" Height="40" Margin="5,0,5,0" Width="160"
                    FontSize="22" Style="{StaticResource ActiveButtonStyle}"/>
			<Button Content="Справочники" Height="40" Margin="5,0,5,0" Width="160"
                    FontSize="22" Style="{StaticResource InactiveButtonStyle}"
                    Click="Button_Directories_Click"/>
			<Button Content="Администрирование" Height="40" Margin="5,0,5,0" Width="215"
                    FontSize="22" Style="{StaticResource InactiveButtonStyle}"
                    Click="Button_Admin_Click"/>
		</WrapPanel>

		<!-- фильтры -->
		<StackPanel Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Background="AliceBlue"
                    Margin="5,0,0,0">
			<TextBlock Text="Тип оборудования" FontSize="24" />
			<ComboBox x:Name="TypeFilterComboBox" Height="50" Background="#61A5C2"
                      SelectionChanged="Filter_SelectionChanged"/>

			<TextBlock Text="Статус" FontSize="24" />
			<ComboBox x:Name="StatusFilterComboBox" Height="50" Background="#61A5C2"
                      SelectionChanged="Filter_SelectionChanged"/>

			<TextBlock Text="Гидропост" FontSize="24" />
			<ComboBox x:Name="HydropostFilterComboBox" Height="50" Background="#61A5C2"
                      SelectionChanged="Filter_SelectionChanged"/>

		</StackPanel>

		<!-- таблица оборудования -->
		<StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0,8,0">
			<WrapPanel Margin="0, 0, 0, 15">
				<TextBlock Text="Оборудование" FontSize="18" VerticalAlignment="Center"
                           Padding="0" Width="1000"/>
				<Button x:Name="BtnAddEquipment" Content="+ Добавить оборудование" Width="200"
                        Background="#2C7DA0" Click="BtnAddEquipment_Click"/>
			</WrapPanel>
			<DataGrid x:Name="EquipmentDataGrid" Height="700" AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
					<DataGridTextColumn Header="Тип" Binding="{Binding EquipmentTypeIdFkNavigation.Name}" Width="*"/>
					<DataGridTextColumn Header="Гидропост" Binding="{Binding HydropostIdFkNavigation.Name}" Width="*"/>
					<DataGridTextColumn Header="Калибровка" Binding="{Binding LastCalibration}" Width="*"/>
					<DataGridTextColumn Header="Статус" Binding="{Binding EquipmentStatusIdFkNavigation.Name}" Width="*"/>
					<DataGridTextColumn Header="Дата добавления" Binding="{Binding CreatedAt}" Width="*"/>
					<DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>
	</Grid>
</Window>