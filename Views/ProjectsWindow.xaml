<Window x:Class="Гидрологические_измерения.Views.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Гидрологические_измерения.Views"
        mc:Ignorable="d"
        Title="Проекты" Height="720" Width="1080">

	<Window.Resources>
		<Style x:Key="ActiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#2C7DA0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>
		<Style x:Key="InactiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="Black"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFE5F3FF"/>
					<Setter Property="Foreground" Value="Black"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Foreground" Value="#4A7B9C"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="300"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
			<Button Content="Главная" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Main_Click"/>
			<Button Content="Проекты" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource ActiveButtonStyle}"/>
			<Button Content="Гидропосты" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_HydroPosts_Click"/>
			<Button Content="Оборудование" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Equipment_Click"/>
			<Button Content="Справочники" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Directories_Click"/>
			<Button Content="Администрирование" Height="40" Margin="5,0,5,0" Width="215"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Admin_Click"/>
		</WrapPanel>

		<StackPanel Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Background="AliceBlue"
						Margin="5,0,0,0">
			<TextBlock Text="Статус проекта" FontSize="24" />
			<ComboBox x:Name="StatusFilterComboBox" Height="50" Background="#61A5C2"
          SelectionChanged="StatusFilterComboBox_SelectionChanged"/>

			<TextBlock Text="Менеджер проекта" FontSize="24"/>
			<ComboBox x:Name="ManagerFilterComboBox" Height="50" Background="#61A5C2"
          SelectionChanged="ManagerFilterComboBox_SelectionChanged"/>

			<TextBlock Text="Дата начала" FontSize="24"/>
			<DatePicker x:Name="StartDateFilterPicker" Height="50" FontSize="14"
            SelectedDateChanged="StartDateFilterPicker_SelectedDateChanged"/>

			<TextBlock Text="Период действия" FontSize="24"/>
			<TextBox Height="50" Foreground="LightGray">
				<TextBox.Text>
					<Binding Path="SomeProperty" TargetNullValue="Введите период даты" FallbackValue="21.10.2025 - 22.11.2026"/>
				</TextBox.Text>
			</TextBox>
		</StackPanel>

		<StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0,8,0">
			<WrapPanel Margin="0, 0, 0, 15">
				<TextBlock Text="Проекты" FontSize="18" VerticalAlignment="Center"
					   Padding="0" Width="1000"/>
				<Button Content="+ Добавить проект" Width="200"
				Background="#2C7DA0" Click="BtnAddProject_Click"/>
			</WrapPanel>
			<DataGrid x:Name="ProjectsDataGrid" Height="700" AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
					<DataGridTextColumn Header="Заказчик" Binding="{Binding Client}" Width="*"/>
					<DataGridTextColumn Header="Менеджер" Binding="{Binding ContractorIdFkNavigation.LastName}" Width="*"/>
					<DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" Width="*"/>
					<DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" Width="*"/>
					<DataGridTextColumn Header="Статус" Binding="{Binding StatusIdFkNavigation.Name}" Width="*"/>
					<DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>
	</Grid>

</Window>