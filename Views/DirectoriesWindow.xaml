<Window x:Class="Гидрологические_измерения.Views.DirectoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Гидрологические_измерения.Views"
        mc:Ignorable="d"
        Title="Справочники" Height="720" Width="1080">

	<Window.Resources>
		<Style x:Key="ActiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#2C7DA0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>
		<Style x:Key="InactiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="Black"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFE5F3FF"/>
					<Setter Property="Foreground" Value="Black"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Foreground" Value="#4A7B9C"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
			<Button Content="Главная" Height="40" Margin="5,0,5,0" Width="160"
				FontSize="22" Style="{StaticResource InactiveButtonStyle}"
				Click="Button_Main_Click"/>
			<Button Content="Проекты" Height="40" Margin="5,0,5,0" Width="160"
				FontSize="22" Style="{StaticResource InactiveButtonStyle}"
				Click="Button_Projects_Click"/>
			<Button Content="Гидропосты" Height="40" Margin="5,0,5,0" Width="160"
				FontSize="22" Style="{StaticResource InactiveButtonStyle}"
				Click="Button_HydroPosts_Click"/>
			<Button Content="Оборудование" Height="40" Margin="5,0,5,0" Width="160"
				FontSize="22" Style="{StaticResource InactiveButtonStyle}"
				Click="Button_Equipment_Click"/>
			<Button Content="Справочники" Height="40" Margin="5,0,5,0" Width="160"
				FontSize="22" Style="{StaticResource ActiveButtonStyle}"/>
			<Button Content="Администрирование" Height="40" Margin="5,0,5,0" Width="215"
				FontSize="22" Style="{StaticResource InactiveButtonStyle}"
				Click="Button_Admin_Click"/>
		</WrapPanel>

		<StackPanel Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Background="AliceBlue"
							Margin="5,0,0,0">

			<TextBlock Text="Список справочников" FontSize="20" Margin="0,0,0,10"/>
			<DataGrid x:Name="DirectoriesDataGrid" Height="700" AutoGenerateColumns="False" 
          IsReadOnly="True" SelectionChanged="DirectoriesDataGrid_SelectionChanged">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}"/>
					<DataGridTextColumn Header="Описание" Width="*" Binding="{Binding Description}"/>
				</DataGrid.Columns>
			</DataGrid>

		</StackPanel>

		<StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Background="AliceBlue"
							Margin="5,0,0,0">

			<WrapPanel Margin="0,0,0,10">
				<TextBlock Text="Значения выбранного справочника" FontSize="20"
							   Width="500"/>
				<Button Content="+ Добавить значение" Width="200"
							Background="#2C7DA0" Click="BtnAddValue_Click"/>
			</WrapPanel>
			<DataGrid x:Name="DirectoryValuesDataGrid" Height="700" AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}"/>
					<DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name}"/>
				</DataGrid.Columns>
			</DataGrid>

		</StackPanel>


	</Grid>
</Window>