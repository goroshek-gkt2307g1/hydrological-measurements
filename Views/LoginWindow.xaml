<Window x:Class="Гидрологические_измерения.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Гидрологические_измерения.Views"
        mc:Ignorable="d"
        Title="Авторизация" Height="720" Width="1080"
		WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition/>
			<ColumnDefinition/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>
		<TextBlock HorizontalAlignment="Center" Grid.Row="0" Grid.Column="1"
                   VerticalAlignment="Bottom" FontSize="48" FontFamily="Inter"
                   FontWeight="Bold">
            Авторизация
		</TextBlock>

		<StackPanel Grid.Row="1" Grid.Column="1" Margin="0, 50,0,0">
			<StackPanel>
				<TextBlock FontSize="26">Логин</TextBlock>
				<TextBox x:Name="inputLogin" Width="640" Height="72" Background="LightGray" 
                         Focusable="True" FontSize="20"/>
			</StackPanel>
			<StackPanel>
				<TextBlock FontSize="26">Пароль</TextBlock>
				<PasswordBox x:Name="inputPassword" Width="640" Height="72" 
                             Background="LightGray" FontSize="20"/>
			</StackPanel>
		</StackPanel>

		<Button Grid.Column="1" Grid.Row="2" Height="80"  VerticalAlignment="Top"
                FontSize="32" Background="#61A5C2" FontWeight="Bold" Content="Войти" Click="Button_Click">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
                            CornerRadius="20">
						<ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Button.Template>
		</Button>

		<!--подсказка с данными для входа-->
		<StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" Margin="0,20,0,0">
			<TextBlock Text="Данные администратора по умолчанию:" FontSize="16" 
			           Foreground="#2C7DA0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Text="Логин: admin" FontSize="14" Foreground="#555555" TextAlignment="Center"/>
			<TextBlock Text="Пароль: admin" FontSize="14" Foreground="#555555" TextAlignment="Center"/>
			<TextBlock Text="(поля заполнены автоматически для удобства)" FontSize="12" 
			           Foreground="#888888" TextAlignment="Center" Margin="0,5,0,0"/>
		</StackPanel>
	</Grid>
</Window>