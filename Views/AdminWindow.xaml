<Window x:Class="Гидрологические_измерения.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Гидрологические_измерения.Views"
        mc:Ignorable="d"
        Title="Администрирование" Height="720" Width="1080">

	<Window.Resources>
		<Style x:Key="ActiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#2C7DA0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>
		<Style x:Key="InactiveButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="Black"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFE5F3FF"/>
					<Setter Property="Foreground" Value="Black"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Foreground" Value="#4A7B9C"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="300"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0">
			<Button Content="Главная" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Main_Click"/>
			<Button Content="Проекты" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Projects_Click"/>
			<Button Content="Гидропосты" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_HydroPosts_Click"/>
			<Button Content="Оборудование" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Equipment_Click"/>
			<Button Content="Справочники" Height="40" Margin="5,0,5,0" Width="160"
            FontSize="22" Style="{StaticResource InactiveButtonStyle}"
            Click="Button_Directories_Click"/>
			<Button Content="Администрирование" Height="40" Margin="5,0,5,0" Width="215"
            FontSize="22" Style="{StaticResource ActiveButtonStyle}"/>
		</WrapPanel>

		<StackPanel Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Background="AliceBlue"
						Margin="5,0,0,0">
			<TextBlock Text="Роль" FontSize="24" />
			<ComboBox x:Name="RoleFilterComboBox" Height="50" Background="#61A5C2"
          SelectionChanged="Filter_SelectionChanged"/>

			<TextBlock Text="Гидропост" FontSize="24" />
			<ComboBox x:Name="HydropostFilterComboBox" Height="50" Background="#61A5C2"
          SelectionChanged="Filter_SelectionChanged"/>

			<TextBlock Text="Дата регистрации" FontSize="24" />
			<DatePicker x:Name="DateFilterPicker" Height="50" FontSize="14"
            SelectedDateChanged="Filter_SelectionChanged"/>

		</StackPanel>

		<StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0,8,0">
			<WrapPanel Margin="0, 0, 0, 15">
				<TextBlock Text="Пользователи" FontSize="18" VerticalAlignment="Center"
					   Padding="0" Width="1000"/>
				<Button Content="+ Добавить пользователя" Width="200"
				Background="#2C7DA0" Click="BtnAddUser_Click"/>
			</WrapPanel>
			<DataGrid x:Name="UsersDataGrid" Height="700" AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
					<DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
					<DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="*"/>
					<DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
					<DataGridTextColumn Header="Роль" Binding="{Binding RoleIdFkNavigation.Name}" Width="*"/>
					<DataGridTextColumn Header="Дата регистрации" Binding="{Binding CreatedAt}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>

	</Grid>
</Window>